# Magento API, proxied server-side by Netlify so the browser makes a
# same-origin request and CORS never comes into it.
/mag/*  https://greenhse.com/:splat  200

# Spec sheets. Same trick as /mag/* above: Netlify fetches these server-side
# from the Magento media folder, so the product pages can link to a plain
# /docs/<file>.pdf path. At the domain cutover this one line moves to
# mag.greenhse.com and all 194 pages keep working. Drop the real PDFs into
# /docs/ and they win automatically — Netlify serves a real file before it
# applies a rewrite.
/docs/*  https://greenhse.com/media/sparsh/product_attachment/:splat  200

# Client logos on the Applications section, proxied the same way as /docs.
/brand/*  https://greenhse.com/media/wysiwyg/:splat  200

