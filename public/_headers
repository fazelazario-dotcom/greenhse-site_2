/ 
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/img/*
  Cache-Control: public, max-age=31536000, immutable

/blog/img/*
  Cache-Control: public, max-age=31536000, immutable

# These filenames never change, so a long cache meant a code fix could sit
# invisible in a returning visitor's browser for up to a week - exactly the
# "why is it still there" problem. They are small and ETagged, so revalidating
# every load costs a 304 and guarantees a deploy is what people actually see.
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
